{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@phash-js/core": ["./packages/core/src/index.ts"],
      "@phash-js/client": ["./packages/client/src/index.ts"],
      "@phash-js/server": ["./packages/server/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["**/node_modules", "**/dist", "coverage", "playwright-report", "test-results"]
}
