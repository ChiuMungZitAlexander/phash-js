{
  "name": "phash-js",
  "version": "2.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/client",
    "packages/example/react"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --cwd packages/core build && bun run --cwd packages/server build && bun run --cwd packages/client build",
    "build:example": "bun run --cwd packages/example/react build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/test-packages.mjs",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "commitlint": "commitlint",
    "prepare": "husky",
    "deps:update": "bun scripts/update-dependencies.mjs",
    "deps:check": "bun scripts/update-dependencies.mjs --check",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "oxc-transform": "^0.157.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.91.0",
    "rollup": "^4.67.5",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4"
}
